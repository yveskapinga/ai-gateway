# Local development only. Copy to .env and keep .env untracked.

POSTGRES_DB=aigateway
POSTGRES_USER=aigateway
POSTGRES_PASSWORD=aigateway_dev_change_me
POSTGRES_PORT=55441
POSTGRES_HOST=127.0.0.1

# Service-to-service key for POST /v1/generate and /v1/embed. Not a user JWT.
AIGW_API_KEY=dev_only_change_me
# Base URL for the PHP SDK (AIGW-006).
AIGW_BASE_URL=http://127.0.0.1:18190

# Secret *names* live in SQL (gateway_provider.secret_env_name). Values stay here.
# GEMINI_API_KEY=
# Ollama is loopback only — do not publish this port.
OLLAMA_BASE_URL=http://127.0.0.1:11434
